+	const UINT32 umask = s->umask, vmask = s->vmask;
+	const INT32 du = s->du, dv = s->dv;
+	const UINT32 tww = m_n_tww, twh = m_n_twh;
+	const UINT32 mw = win ? psx_ts_recip( 0, tww ) : 0, mh = win ? psx_ts_recip( 1, twh ) : 0;
+	UINT32 u = s->u, v = s->v, r = s->r, g = s->g, b = s->b;
+	v128_t r_lo = wasm_i32x4_add( wasm_i32x4_splat( (INT32)r ), wasm_i32x4_mul( lane_lo, wasm_i32x4_splat( s->dr ) ) );
+	v128_t r_hi = wasm_i32x4_add( wasm_i32x4_splat( (INT32)r ), wasm_i32x4_mul( lane_hi, wasm_i32x4_splat( s->dr ) ) );
+	v128_t g_lo = wasm_i32x4_add( wasm_i32x4_splat( (INT32)g ), wasm_i32x4_mul( lane_lo, wasm_i32x4_splat( s->dg ) ) );
+	v128_t g_hi = wasm_i32x4_add( wasm_i32x4_splat( (INT32)g ), wasm_i32x4_mul( lane_hi, wasm_i32x4_splat( s->dg ) ) );
+	v128_t b_lo = wasm_i32x4_add( wasm_i32x4_splat( (INT32)b ), wasm_i32x4_mul( lane_lo, wasm_i32x4_splat( s->db ) ) );
+	v128_t b_hi = wasm_i32x4_add( wasm_i32x4_splat( (INT32)b ), wasm_i32x4_mul( lane_hi, wasm_i32x4_splat( s->db ) ) );
+	const v128_t r_step = wasm_i32x4_splat( (INT32)( (UINT32)s->dr * 8 ) );
+	const v128_t g_step = wasm_i32x4_splat( (INT32)( (UINT32)s->dg * 8 ) );
+	const v128_t b_step = wasm_i32x4_splat( (INT32)( (UINT32)s->db * 8 ) );
+	const v128_t semi_bgr = wasm_i16x8_splat( (INT16)( s->semi ? 0xc210 : 0x4210 ) );
+	const UINT16 *row = NULL;
+	/* texel addresses on 8 lanes when vram is a power of 2 high (no texture window) */
+	const UINT32 vram_h = m_n_vram_height;
+	const int vecrows = !win && ( vram_h & ( vram_h - 1 ) ) == 0 && m_n_vram_width <= 0xffff;
+	const v128_t du_lo = wasm_i32x4_mul( lane_lo, wasm_i32x4_splat( du ) ), du_hi = wasm_i32x4_mul( lane_hi, wasm_i32x4_splat( du ) );
