+				bgr = wasm_u16x8_make( clut[ p8[ 0 ] ], clut[ p8[ 1 ] ], clut[ p8[ 2 ] ], clut[ p8[ 3 ] ],
+					clut[ p8[ 4 ] ], clut[ p8[ 5 ] ], clut[ p8[ 6 ] ], clut[ p8[ 7 ] ] );
+			}
+			u += 0x80000;
+			v += dv * 8;
+		}
+		else if( vecrows )
+		{
+			/* texel addresses on all 8 lanes, then one load per lane (unused lanes read */
+			/* inside vram and are made transparent below) */
+			const v128_t uu_lo = wasm_i32x4_add( wasm_i32x4_splat( (INT32)u ), du_lo ), uu_hi = wasm_i32x4_add( wasm_i32x4_splat( (INT32)u ), du_hi );
+			const v128_t vv_lo = wasm_i32x4_add( wasm_i32x4_splat( (INT32)v ), dv_lo ), vv_hi = wasm_i32x4_add( wasm_i32x4_splat( (INT32)v ), dv_hi );
+			const v128_t n_u = wasm_v128_and( wasm_i8x16_shuffle( uu_lo, uu_hi, 2, 3, 6, 7, 10, 11, 14, 15, 18, 19, 22, 23, 26, 27, 30, 31 ), umask_v );
+			const v128_t n_v = wasm_v128_and( wasm_i8x16_shuffle( vv_lo, vv_hi, 2, 3, 6, 7, 10, 11, 14, 15, 18, 19, 22, 23, 26, 27, 30, 31 ), vmask_v );
+			const v128_t line = wasm_v128_and( wasm_i16x8_add( n_v, ty_v ), hmask_v );
+			const v128_t n_w = tp == 0 ? wasm_u16x8_shr( n_u, 2 ) : tp == 1 ? wasm_u16x8_shr( n_u, 1 ) : n_u;
+			const v128_t idx_lo = wasm_i32x4_add( wasm_i32x4_add( wasm_i32x4_mul( wasm_u32x4_extend_low_u16x8( line ), vw_v ), tx_v ), wasm_u32x4_extend_low_u16x8( n_w ) );
+			const v128_t idx_hi = wasm_i32x4_add( wasm_i32x4_add( wasm_i32x4_mul( wasm_u32x4_extend_high_u16x8( line ), vw_v ), tx_v ), wasm_u32x4_extend_high_u16x8( n_w ) );
+			const v128_t w = wasm_u16x8_make(
+				vr[ (UINT32)wasm_i32x4_extract_lane( idx_lo, 0 ) ], vr[ (UINT32)wasm_i32x4_extract_lane( idx_lo, 1 ) ],
+				vr[ (UINT32)wasm_i32x4_extract_lane( idx_lo, 2 ) ], vr[ (UINT32)wasm_i32x4_extract_lane( idx_lo, 3 ) ],
+				vr[ (UINT32)wasm_i32x4_extract_lane( idx_hi, 0 ) ], vr[ (UINT32)wasm_i32x4_extract_lane( idx_hi, 1 ) ],
+				vr[ (UINT32)wasm_i32x4_extract_lane( idx_hi, 2 ) ], vr[ (UINT32)wasm_i32x4_extract_lane( idx_hi, 3 ) ] );
+			if( tp == 0 )
+			{
+				/* 4-bit: the nibble (n_u & 3) of each word, then the CLUT as a byte table lookup */
+				const v128_t sel = wasm_v128_and( n_u, wasm_i16x8_splat( 3 ) );
+				const v128_t m4 = wasm_i16x8_splat( 0x0f );
+				v128_t nib = wasm_v128_and( w, m4 );
+				v128_t idx8;
+				nib = wasm_v128_bitselect( wasm_v128_and( wasm_u16x8_shr( w, 4 ), m4 ), nib, wasm_i16x8_eq( sel, wasm_i16x8_splat( 1 ) ) );
+				nib = wasm_v128_bitselect( wasm_v128_and( wasm_u16x8_shr( w, 8 ), m4 ), nib, wasm_i16x8_eq( sel, wasm_i16x8_splat( 2 ) ) );
+				nib = wasm_v128_bitselect( wasm_u16x8_shr( w, 12 ), nib, wasm_i16x8_eq( sel, wasm_i16x8_splat( 3 ) ) );
