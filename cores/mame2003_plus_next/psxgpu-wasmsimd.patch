+	v128_t r_hi = wasm_i32x4_add( wasm_i32x4_splat( (INT32)r ), wasm_i32x4_mul( lane_hi, wasm_i32x4_splat( s->dr ) ) );
+	v128_t g_lo = wasm_i32x4_add( wasm_i32x4_splat( (INT32)g ), wasm_i32x4_mul( lane_lo, wasm_i32x4_splat( s->dg ) ) );
+	v128_t g_hi = wasm_i32x4_add( wasm_i32x4_splat( (INT32)g ), wasm_i32x4_mul( lane_hi, wasm_i32x4_splat( s->dg ) ) );
+	v128_t b_lo = wasm_i32x4_add( wasm_i32x4_splat( (INT32)b ), wasm_i32x4_mul( lane_lo, wasm_i32x4_splat( s->db ) ) );
+	v128_t b_hi = wasm_i32x4_add( wasm_i32x4_splat( (INT32)b ), wasm_i32x4_mul( lane_hi, wasm_i32x4_splat( s->db ) ) );
