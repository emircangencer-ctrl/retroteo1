+	const UINT16 *vr = m_p_vram;
+	v128_t clut_lo = zero, clut_hi = zero;
+	int i;
+
+	if( fixrow )
+	{
+		row = m_p_p_vram[ s->ty + ( ( v >> 16 ) & vmask ) ] + s->tx;
+	}
