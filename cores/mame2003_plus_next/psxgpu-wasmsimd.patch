+	const v128_t umask_v = wasm_i16x8_splat( (INT16)umask ), vmask_v = wasm_i16x8_splat( (INT16)vmask );
+	const v128_t ty_v = wasm_i16x8_splat( (INT16)s->ty ), hmask_v = wasm_i16x8_splat( (INT16)( vram_h - 1 ) );
