diff --git a/src/cpu/mips/psx_cpu.c b/src/cpu/mips/psx_cpu.c
index a7f811a3..89d7b8ab 100644
--- a/src/cpu/mips/psx_cpu.c
+++ b/src/cpu/mips/psx_cpu.c
@@ -1793,6 +1793,9 @@ static INLINE void mips_step( void )
 
 int mips_execute( int cycles )
 {
+#ifdef PSXWASM_STATS
+	jit_stat_slice( cycles );
+#endif
 	mips_ICount = cycles;
 	/* a polling loop's pass is only trusted within one timeslice (psxloop.c): */
 	/* RAM may change between timeslices, and after a state load or a reset */
@@ -1812,7 +1815,17 @@ int mips_execute( int cycles )
 				pc_hook_fn();
 			}
 			mipscpu.op = cpu_readop32( from );
+#ifdef PSXWASM_STATS
+			{
+				int slow = psx_slow_access;
+				psx_slow_access = 0;
+				mips_step();
+				jit_stat_interp( mipscpu.op, psx_slow_access, from );
+				psx_slow_access |= slow;
+			}
+#else
 			mips_step();
+#endif
 			mips_ICount--;
 			/* back to an earlier address: maybe a wait loop to skip (psxloop.c) */
 			if( mipscpu.pc < from && mipscpu.delayr == 0 )
@@ -2377,6 +2390,9 @@ unsigned mips_dasm( char *buffer, UINT32 pc )
 
 static void docop2( int gteop )
 {
+#ifdef PSXWASM_STATS
+	jit_stat_gte( gteop );
+#endif
 	if( !gte_docop2( gteop ) )
 	{
 		usrintf_showmessage_secs( 1, "unknown GTE op %08x", gteop );
diff --git a/src/cpu/mips/psxjit.c b/src/cpu/mips/psxjit.c
index 85fea82e..3e06ebaa 100644
--- a/src/cpu/mips/psxjit.c
+++ b/src/cpu/mips/psxjit.c
@@ -41,6 +41,13 @@
 
 #define PSXJIT_SUPPORTED		SLJIT_MAME_SUPPORTED
 
+/* without sljit, browser builds recompile to WebAssembly instead (psxwasm.c) */
+#if !PSXJIT_SUPPORTED && defined( __EMSCRIPTEN__ ) && !defined( PSXWASM_DISABLE )
+#define PSXWASM_SUPPORTED		1
+#else
+#define PSXWASM_SUPPORTED		0
+#endif
+
 #if PSXJIT_SUPPORTED
 
 #if (defined SLJIT_64BIT_ARCHITECTURE && SLJIT_64BIT_ARCHITECTURE)
@@ -1800,7 +1807,11 @@ static void jit_reset_flush( void )
 	jit_flush();
 }
 
-#else	/* !PSXJIT_SUPPORTED */
+#elif PSXWASM_SUPPORTED
+
+#include "psxwasm.c"
+
+#else	/* !PSXJIT_SUPPORTED && !PSXWASM_SUPPORTED */
 
 static void jit_reset_flush( void ) { }
 
@@ -1819,12 +1830,12 @@ void psxcpu_ram_written( const void *host, UINT32 bytes )
 
 int psxcpu_jit_available( void )
 {
-	return PSXJIT_SUPPORTED;
+	return PSXJIT_SUPPORTED || PSXWASM_SUPPORTED;
 }
 
 void psxcpu_set_jit( int enable )
 {
-#if PSXJIT_SUPPORTED
+#if PSXJIT_SUPPORTED || PSXWASM_SUPPORTED
 	if( enable && !jit_table )
 	{
 		jit_enabled = 1;
diff --git a/src/cpu/mips/psxloop.c b/src/cpu/mips/psxloop.c
index c822994b..019d8274 100644
--- a/src/cpu/mips/psxloop.c
+++ b/src/cpu/mips/psxloop.c
@@ -66,7 +66,7 @@ static UINT32 *loop_data( UINT32 address )
 		return NULL;
 	}
 	host = &r->base[ address - r->start ];
-#if PSXJIT_SUPPORTED
+#if PSXJIT_SUPPORTED || PSXWASM_SUPPORTED
 	if( jit_code_present && jit_codemap[ jit_codemap_index( host ) ] )
