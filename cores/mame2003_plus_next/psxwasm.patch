 		return NULL;
@@ -585,4 +585,9 @@ static void SLJIT_FUNC loop_skip_helper( sljit_u32 l )
 {
 	loop_skip_at( l );
 }
+#elif PSXWASM_SUPPORTED
+static void loop_skip_helper( UINT32 l )
